---
import type { LandingStrings } from '../../landing/strings';

interface Props {
  strings: LandingStrings;
}

const { strings } = Astro.props;

// What the sections above do not already show, in one line each.
const SPEC = [
  { dt: strings['spec.sound.dt'], dd: strings['spec.sound.dd'] },
  { dt: strings['spec.import.dt'], dd: strings['spec.import.dd'] },
  { dt: strings['spec.preview.dt'], dd: strings['spec.preview.dd'] },
  { dt: strings['spec.lang.dt'], dd: strings['spec.lang.dd'] },
  { dt: strings['spec.resume.dt'], dd: strings['spec.resume.dd'] },
];
---

<section aria-labelledby="spec-title">
  <h2 id="spec-title">{strings['spec.title']}</h2>
  <dl class="spec">
    {
      SPEC.map((row) => (
        <div>
          <dt>{row.dt}</dt>
          <dd>{row.dd}</dd>
        </div>
      ))
    }
  </dl>
</section>

<style>
  /* A spec sheet, not another column grid: one row per fact, the name on
     the left and the detail beside it, read straight down. */
  .spec {
    margin-top: clamp(2rem, 4vw, 3rem);
    border-bottom: 1px solid var(--hair);
  }
  .spec > div {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
    gap: 0.35rem clamp(1.5rem, 4vw, 3rem);
    align-items: baseline;
    padding-block: 1.25rem;
    border-top: 1px solid var(--hair);
  }
  dt {
    font-family: var(--font-display);
    font-weight: 650;
    letter-spacing: -0.01em;
  }
  dd {
    margin: 0;
    max-width: 60ch;
    color: var(--muted);
    font-size: 0.9375rem;
    line-height: 1.55;
    text-wrap: pretty;
  }
  @media (max-width: 36rem) {
    .spec > div {
      grid-template-columns: 1fr;
    }
  }
</style>
