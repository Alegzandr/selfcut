---
import type { LandingStrings } from '../../landing/strings';

interface Props {
  strings: LandingStrings;
}

const { strings } = Astro.props;

// The descriptions are the only rich strings on the page besides the hero
// title: two of them spell keyboard shortcuts with <kbd>, so the whole column
// is rendered as markup rather than escaped text.
const SPEC = [
  { dt: strings['features.tracks.dt'], dd: strings['features.tracks.dd'] },
  { dt: strings['features.cut.dt'], dd: strings['features.cut.dd'] },
  { dt: strings['features.sound.dt'], dd: strings['features.sound.dd'] },
  { dt: strings['features.preview.dt'], dd: strings['features.preview.dd'] },
  { dt: strings['features.export.dt'], dd: strings['features.export.dd'] },
  { dt: strings['features.mobile.dt'], dd: strings['features.mobile.dd'] },
  { dt: strings['features.lang.dt'], dd: strings['features.lang.dd'] },
];
---

<section id="features" aria-labelledby="features-title">
  <h2 id="features-title">{strings['features.title']}</h2>
  <p class="section-intro">{strings['features.intro']}</p>
  <dl class="spec">
    {
      SPEC.map((row) => (
        <>
          <dt>{row.dt}</dt>
          <dd set:html={row.dd} />
        </>
      ))
    }
  </dl>
</section>

<style>
  .spec {
    margin-top: 2.5rem;
    display: grid;
    grid-template-columns: minmax(9rem, 15rem) 1fr;
    max-width: 58rem;
  }
  .spec dt,
  .spec dd {
    padding: 1.05rem 0;
    border-top: 1px solid var(--line-soft);
  }
  .spec dt {
    font-weight: 700;
    font-stretch: 108%;
    padding-right: 1.5rem;
  }
  .spec dd {
    color: var(--muted);
  }
  /* :global because the <kbd> elements come from the translated strings, so
     they are not in this template and never get the scoping attribute. */
  .spec :global(kbd) {
    font-family: inherit;
    font-variant-numeric: tabular-nums;
    font-size: 0.85em;
    font-weight: 600;
    color: var(--text);
    background: var(--surface);
    border: 1px solid var(--line);
    border-bottom-width: 2px;
    border-radius: 4px;
    padding: 0.1em 0.45em;
    white-space: nowrap;
    transition: translate 0.1s ease-out;
  }
  .spec :global(kbd:hover) {
    translate: 0 1px;
  }
  @media (max-width: 40rem) {
    .spec {
      grid-template-columns: 1fr;
    }
    .spec dt {
      padding-bottom: 0.2rem;
    }
    .spec dd {
      border-top: 0;
      padding-top: 0;
    }
  }
</style>
