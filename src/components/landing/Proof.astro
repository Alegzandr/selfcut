---
import type { LandingStrings } from '../../landing/strings';

interface Props {
  strings: LandingStrings;
}

const { strings } = Astro.props;

const CLAIMS = [
  { title: strings['proof.1.title'], body: strings['proof.1.body'] },
  { title: strings['proof.2.title'], body: strings['proof.2.body'] },
  { title: strings['proof.3.title'], body: strings['proof.3.body'] },
];
---

{/* The quiet passage between two dense ones: no picture, the statement at
    full size, and what it makes possible underneath. */}
<section id="privacy" class="privacy" aria-labelledby="proof-title">
  <svg class="lock" viewBox="0 0 15 15" aria-hidden="true"><use href="#i-LockClosed"></use></svg>
  <h2 id="proof-title" set:html={strings['proof.title']} />
  <p class="lede">{strings['proof.lead']}</p>
  <ul class="claims">
    {
      CLAIMS.map((claim) => (
        <li>
          <h3>{claim.title}</h3>
          <p>{claim.body}</p>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .privacy {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }
  .lock {
    width: 2.75rem;
    height: 2.75rem;
    padding: 0.7rem;
    margin-bottom: 1.75rem;
    border: 1px solid var(--hair-strong);
    border-radius: 0.75rem;
    background: var(--raised);
    color: var(--text);
  }
  h2 {
    font-size: clamp(2.3rem, 5.2vw, 4rem);
    max-width: 18ch;
  }
  .lede {
    max-width: 52ch;
  }

  .claims {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin-top: clamp(3rem, 6vw, 4.5rem);
    padding: 0;
    list-style: none;
    text-align: left;
    border-top: 1px solid var(--hair);
  }
  .claims li {
    padding: 1.75rem clamp(1.25rem, 3vw, 2.5rem) 0 0;
  }
  .claims li + li {
    padding-left: clamp(1.25rem, 3vw, 2.5rem);
    border-left: 1px solid var(--hair);
  }
  .claims p {
    margin-top: 0.5rem;
    color: var(--muted);
    font-size: 0.9375rem;
    line-height: 1.6;
    text-wrap: pretty;
  }

  @media (max-width: 48rem) {
    .privacy {
      align-items: flex-start;
      text-align: left;
    }
    .claims {
      grid-template-columns: 1fr;
    }
    .claims li,
    .claims li + li {
      padding: 1.5rem 0;
      border-left: 0;
    }
    .claims li + li {
      border-top: 1px solid var(--hair);
    }
  }
</style>
