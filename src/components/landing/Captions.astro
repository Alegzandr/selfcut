---
import type { LandingStrings } from '../../landing/strings';

interface Props {
  strings: LandingStrings;
}

const { strings } = Astro.props;

// Three cues, drawn the way the subtitle list draws them: a timecode and the
// line. The frame above burns in whichever cue the list has active, on one
// shared clock, so the picture and the list cannot disagree.
const CUES = [
  { time: '00:04', text: strings['captions.cue.1'] },
  { time: '00:07', text: strings['captions.cue.2'] },
  { time: '00:11', text: strings['captions.cue.3'] },
];
---

<section id="captions" aria-labelledby="captions-title">
  <div class="grid">
    <div class="copy">
      <h2 id="captions-title" set:html={strings['captions.title']} />
      <p class="lede">{strings['captions.lead']}</p>
      {/* Said here rather than only in the FAQ: someone who reads "your audio
          does not leave" and then watches a model download should have been
          told. */}
      <p class="note">{strings['captions.note']}</p>
    </div>

    <div class="demo" aria-hidden="true">
      <div class="frame">
        <img src="/landing/monitor-36.webp" alt="" width="960" height="540" loading="lazy" />
        {CUES.map((cue, i) => <span class:list={['sub', `c${i}`]}>{cue.text}</span>)}
      </div>
      <ol class="cues">
        {
          CUES.map((cue, i) => (
            <li class={`c${i}`}>
              <span class="tc">{cue.time}</span>
              <span class="line">{cue.text}</span>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>

<style>
  .grid {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    align-items: center;
    gap: clamp(2.5rem, 6vw, 5.5rem);
  }
  .copy .note {
    margin-top: 1.5rem;
    max-width: 48ch;
  }

  .demo {
    --loop: 9s;
    display: grid;
    gap: 0.75rem;
  }

  .frame {
    position: relative;
    overflow: hidden;
    border-radius: 0.875rem;
    border: 1px solid var(--hair-strong);
    box-shadow: 0 1.5rem 4rem -1.5rem oklch(0% 0 0 / 0.75);
  }
  .frame img {
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }
  /* The caption pill the editor's text clips render: white type on a dark
     rounded box, centred over the lower third. */
  .sub {
    position: absolute;
    left: 50%;
    bottom: 9%;
    translate: -50% 0;
    max-width: 86%;
    width: max-content;
    padding: 0.3em 0.7em;
    border-radius: 0.4em;
    background: oklch(0% 0 0 / 0.72);
    color: white;
    font-family: var(--font-display);
    font-size: clamp(0.875rem, 1.6vw, 1.2rem);
    font-weight: 700;
    line-height: 1.3;
    text-align: center;
    opacity: 0;
  }
  .sub.c0 {
    opacity: 1;
  }

  .cues {
    display: grid;
    gap: 0.25rem;
    padding: 0.4rem;
    list-style: none;
    border: 1px solid var(--hair);
    border-radius: 0.875rem;
    background: var(--raised);
  }
  .cues li {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    padding: 0.65rem 0.85rem;
    border-radius: 0.5rem;
    color: var(--faint);
  }
  .cues li.c0 {
    background: oklch(100% 0 0 / 0.06);
    color: var(--text);
  }
  .tc {
    flex: none;
    font-family: var(--font-app);
    font-size: 0.8125rem;
    font-variant-numeric: tabular-nums;
    color: var(--faint);
  }
  .line {
    font-size: 0.9375rem;
    text-wrap: pretty;
  }

  /* One clock for picture and list: each cue owns a third of the loop. */
  @media (prefers-reduced-motion: no-preference) {
    .sub {
      animation: on-sub var(--loop) step-end infinite;
    }
    .cues li {
      animation: on-row var(--loop) step-end infinite;
    }
    .c1 {
      animation-delay: calc(var(--loop) / -3 * 2) !important;
    }
    .c2 {
      animation-delay: calc(var(--loop) / -3) !important;
    }
    @keyframes on-sub {
      0% {
        opacity: 1;
      }
      33.333% {
        opacity: 0;
      }
    }
    @keyframes on-row {
      0% {
        background: oklch(100% 0 0 / 0.06);
        color: var(--text);
      }
      33.333% {
        background: transparent;
        color: var(--faint);
      }
    }
  }

  @media (max-width: 56rem) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
