---
import Editor from './Editor.astro';
import type { LandingStrings } from '../../landing/strings';
import type { LangCode } from '../../landing/langs';

interface Props {
  strings: LandingStrings;
  code: LangCode;
}

const { strings, code } = Astro.props;
---

<div class="hero">
  <div class="copy wrap">
    {/* Carries a <br /> and the <em> that steps the second clause down. */}
    <h1 set:html={strings['hero.title']} />
    <p class="lede">{strings['hero.lead']}</p>
    <div class="cta">
      <a class="btn btn-primary big" href="/app/"
        >{strings['hero.cta']}<svg viewBox="0 0 15 15" aria-hidden="true"
          ><use href="#i-ArrowRight"></use></svg
        ></a
      >
      <a class="btn btn-ghost big" href="#features">{strings['hero.more']}</a>
    </div>
    {/* Browser support is answered in the FAQ; the hero keeps one line of
        reassurance under the buttons. */}
    <p class="note">{strings['hero.note']}</p>
  </div>

  {/* The real editor, at a real size: the one picture on the page that says
      "this is a complete tool" faster than any sentence. */}
  <div class="stage">
    <div class="tilt"><Editor code={code} eager /></div>
  </div>
</div>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    /* The editor bleeds off the right edge on a phone; clipped here so the
       page itself never scrolls sideways. */
    overflow-x: clip;
    padding-top: clamp(2.5rem, 4vw, 3rem);
  }
  /* Light from above: a wide, faint violet wash behind the headline that
     falls off before the editor, so the product sits in the lit area. */
  .hero::before {
    content: '';
    position: absolute;
    z-index: -1;
    inset: 0 0 auto;
    height: min(62rem, 120vh);
    background:
      radial-gradient(
        60% 50% at 50% 0%,
        oklch(52% 0.2 293 / 0.2),
        transparent 70%
      ),
      radial-gradient(
        35% 30% at 50% 0%,
        oklch(80% 0.06 293 / 0.08),
        transparent 80%
      );
    pointer-events: none;
  }

  .copy {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  h1 {
    font-size: clamp(2.75rem, 6.2vw, 4.5rem);
    line-height: 0.98;
    letter-spacing: -0.038em;
    max-width: 16ch;
  }
  h1:is(:lang(ja), :lang(zh), :lang(ko)) {
    letter-spacing: 0;
  }

  .copy .lede {
    margin-top: 1.25rem;
    max-width: 44rem;
    font-size: clamp(1.0625rem, 1.5vw, 1.25rem);
  }

  .cta {
    margin-top: 1.5rem;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
  }
  .big {
    min-height: 3rem;
    padding: 0.75rem 1.4rem;
    font-size: 1.0625rem;
  }
  .copy .note {
    margin-top: 1rem;
    font-size: 0.875rem;
  }

  /* The editor. It sizes itself from `.app`'s font-size (everything inside is
     in em, 64em wide), so one clamp fits it to the column on desktop and lets
     it run off the right edge on a phone rather than shrink into a stamp. */
  .stage {
    margin-top: clamp(1.75rem, 2.5vw, 2rem);
    padding-inline: var(--pad);
    display: flex;
    justify-content: center;
    perspective: 2400px;
    /* The bottom of the editor dissolves into the page: it is a window onto a
       working tool, not a framed screenshot. */
    mask-image: linear-gradient(to bottom, black 62%, transparent 98%);
  }
  .tilt {
    transform-origin: 50% 0%;
  }
  .stage :global(.app) {
    font-size: clamp(7.5px, calc((100vw - 2 * var(--pad)) / 64), 17px);
    border-color: var(--hair-strong);
    box-shadow:
      0 0 0 1px oklch(0% 0 0 / 0.6),
      0 2.5rem 6rem -1rem oklch(0% 0 0 / 0.7),
      0 -1px 0 0 oklch(100% 0 0 / 0.12);
  }

  /* The one authored motion: the editor rests tilted back and lays itself flat
     as the page scrolls toward it. Scroll-driven, so it costs nothing on the
     main thread; without support (or with reduced motion) it is simply flat. */
  @supports (animation-timeline: scroll()) {
    @media (prefers-reduced-motion: no-preference) {
      .tilt {
        animation: lay-flat linear both;
        animation-timeline: scroll(root);
        animation-range: 0 70vh;
      }
      @keyframes lay-flat {
        from {
          transform: rotateX(16deg) scale(0.95) translateY(0);
        }
        to {
          transform: rotateX(0deg) scale(1) translateY(-1.5rem);
        }
      }
    }
  }

  @media (max-width: 40rem) {
    .stage {
      justify-content: flex-start;
      padding-right: 0;
    }
    .stage :global(.app) {
      border-top-right-radius: 0;
      border-bottom-right-radius: 0;
    }
  }
</style>
