---
import { faqEntries, type LandingStrings } from '../../landing/strings';

interface Props {
  strings: LandingStrings;
}

const { strings } = Astro.props;
const entries = faqEntries(strings);
---

<section id="faq" aria-labelledby="faq-title">
  <h2 id="faq-title">{strings['faq.title']}</h2>
  <div class="faq-list">
    {
      entries.map((entry) => (
        <details>
          <summary>{entry.question}</summary>
          <p>{entry.answer}</p>
        </details>
      ))
    }
  </div>
</section>

<style>
  .faq-list {
    margin-top: 2rem;
    max-width: 58rem;
  }
  .faq-list details {
    border-top: 1px solid var(--line-soft);
  }
  .faq-list details:last-child {
    border-bottom: 1px solid var(--line-soft);
  }
  .faq-list summary {
    list-style: none;
    cursor: pointer;
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    padding: 1.15rem 0.25rem;
    font-size: 1.12rem;
    font-weight: 650;
    font-stretch: 106%;
  }
  .faq-list summary::-webkit-details-marker {
    display: none;
  }
  .faq-list summary::after {
    content: '+';
    color: var(--accent);
    font-weight: 500;
    font-size: 1.3rem;
    line-height: 1;
    transition: rotate 0.2s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .faq-list details[open] summary::after {
    rotate: 45deg;
  }
  .faq-list details p {
    padding: 0 0.25rem 1.3rem;
    max-width: var(--measure);
    color: var(--muted);
  }
  @media (prefers-reduced-motion: no-preference) {
    .faq-list details[open] p {
      animation: faq-in 0.25s cubic-bezier(0.22, 1, 0.36, 1);
    }
    @keyframes faq-in {
      from {
        opacity: 0;
        translate: 0 -0.25rem;
      }
    }
  }
</style>
