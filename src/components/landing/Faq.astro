---
import { faqEntries, type LandingStrings } from '../../landing/strings';

interface Props {
  strings: LandingStrings;
}

const { strings } = Astro.props;
const entries = faqEntries(strings);
---

<section id="faq" aria-labelledby="faq-title">
  <div class="grid">
    <h2 id="faq-title">{strings['faq.title']}</h2>
    <div class="faq-list">
      {
        entries.map((entry) => (
          <details>
            <summary>
              {entry.question}
              <svg viewBox="0 0 15 15" aria-hidden="true"><use href="#i-Plus" /></svg>
            </summary>
            <p>{entry.answer}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  /* Heading on the left, questions on the right: the list reads as one
     column of its own instead of trailing under a heading. */
  .grid {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.6fr);
    gap: 2rem clamp(2rem, 6vw, 5rem);
    align-items: start;
  }
  h2 {
    position: sticky;
    top: 6rem;
  }
  .faq-list details {
    border-bottom: 1px solid var(--hair);
  }
  .faq-list details:first-child {
    border-top: 1px solid var(--hair);
  }
  .faq-list summary {
    list-style: none;
    cursor: pointer;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1.5rem;
    min-height: 44px;
    padding: 1.3rem 0;
    font-family: var(--font-display);
    font-size: 1.0625rem;
    font-weight: 650;
    letter-spacing: -0.012em;
    transition: color 0.15s ease-out;
  }
  .faq-list summary::-webkit-details-marker {
    display: none;
  }
  .faq-list summary:hover {
    color: white;
  }
  .faq-list summary svg {
    flex: none;
    width: 1.1rem;
    height: 1.1rem;
    color: var(--muted);
    transition: rotate 0.25s var(--ease-out), color 0.15s ease-out;
  }
  .faq-list summary:hover svg {
    color: var(--text);
  }
  .faq-list details[open] summary svg {
    rotate: 45deg;
  }
  .faq-list details p {
    padding: 0 2.5rem 1.5rem 0;
    max-width: var(--measure);
    color: var(--muted);
    font-size: 0.9875rem;
    line-height: 1.65;
  }
  @media (prefers-reduced-motion: no-preference) {
    .faq-list details[open] p {
      animation: faq-in 0.3s var(--ease-out);
    }
    @keyframes faq-in {
      from {
        opacity: 0;
        translate: 0 -0.35rem;
      }
    }
  }
  @media (max-width: 52rem) {
    .grid {
      grid-template-columns: 1fr;
    }
    h2 {
      position: static;
    }
  }
</style>
