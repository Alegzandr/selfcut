---
import type { LandingStrings } from '../../landing/strings';

interface Props {
  strings: LandingStrings;
  /** The current language's own landing page: the wordmark links home. */
  home: string;
}

const { strings, home } = Astro.props;

const LINKS = [
  { href: '#features', label: strings['footer.features'] },
  { href: '#formats', label: strings['nav.formats'] },
  { href: '#privacy', label: strings['nav.privacy'] },
  { href: '#faq', label: strings['footer.faq'] },
];
---

<header class="wrap">
  <a class="wordmark" href={home}
    ><img src="/landing/logo-48.png" alt="" width="48" height="48" />SelfCut</a
  >
  <nav aria-label={strings['nav.label']}>
    {LINKS.map((link) => <a href={link.href}>{link.label}</a>)}
  </nav>
  <a class="btn btn-primary" href="/app/">{strings['header.cta']}</a>
</header>

<style>
  header {
    position: sticky;
    top: 0;
    z-index: 50;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1rem;
    height: 4rem;
    border-bottom: 1px solid var(--hair);
    /* Blur is the effect here, not decoration: the editor and the stills
       scroll under a header that has to stay legible over them. */
    background: color-mix(in oklab, var(--bg) 78%, transparent);
    backdrop-filter: blur(14px) saturate(1.4);
  }

  .wordmark {
    justify-self: start;
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    min-height: 44px;
    text-decoration: none;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.125rem;
    letter-spacing: -0.02em;
  }
  .wordmark img {
    width: 1.5rem;
    height: 1.5rem;
  }

  nav {
    display: flex;
    gap: 0.25rem;
  }
  nav a {
    padding: 0.5rem 0.8rem;
    border-radius: 0.5rem;
    color: var(--muted);
    font-size: 0.9375rem;
    text-decoration: none;
    transition: color 0.15s ease-out;
  }
  nav a:hover {
    color: var(--text);
  }

  header .btn {
    justify-self: end;
    min-height: 2.25rem;
    padding: 0.4rem 0.9rem;
    font-size: 0.9375rem;
  }

  @media (max-width: 52rem) {
    header {
      grid-template-columns: 1fr auto;
      height: 3.5rem;
    }
    nav {
      display: none;
    }
    /* Still a 44px target: the visible pill is smaller than its hit area. */
    header .btn {
      position: relative;
    }
    header .btn::after {
      content: '';
      position: absolute;
      inset: -0.5rem -0.25rem;
    }
  }
</style>
