{
  "name": "selfcut",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "tsc && astro build",
    "preview": "astro preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "lint": "oxlint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:prod": "playwright test -c playwright.prod.config.ts",
    "bench": "vitest run -c vitest.bench.config.ts",
    "test:e2e:perf": "playwright test e2e/perf.spec.ts",
    "test:e2e:swiftshader": "playwright test -c playwright.swiftshader.config.ts e2e/perf.spec.ts e2e/exportPerf.spec.ts"
  },
  "dependencies": {
    "@ffmpeg/core": "^0.12.10",
    "@ffmpeg/core-mt": "^0.12.10",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "@huggingface/transformers": "^4.2.0",
    "@mediabunny/aac-encoder": "^1.54.0",
    "@mediabunny/mp3-encoder": "^1.54.0",
    "framer-motion": "^13.1.0",
    "i18next": "^26.3.6",
    "i18next-browser-languagedetector": "^8.2.1",
    "immer": "^11.1.17",
    "lucide-react": "^1.31.0",
    "mediabunny": "^1.54.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.11",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@astrojs/react": "^6.0.2",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "astro": "^7.2.2",
    "oxlint": "^1.78.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
