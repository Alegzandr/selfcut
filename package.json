{
  "name": "selfcut",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "tsc && astro build",
    "preview": "astro preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "lint": "oxlint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --project=ui --workers=4",
    "test:e2e:render": "playwright test --project=render --workers=1",
    "test:e2e:prod": "playwright test -c playwright.prod.config.ts",
    "bench": "vitest run -c vitest.bench.config.ts",
    "test:e2e:perf": "playwright test e2e/perf.spec.ts",
    "test:e2e:swiftshader": "playwright test -c playwright.swiftshader.config.ts --project=render --workers=1 e2e/perf.spec.ts e2e/exportPerf.spec.ts e2e/exportParallel.spec.ts"
  },
  "dependencies": {
    "@ffmpeg/core": "^0.12.10",
    "@ffmpeg/core-mt": "^0.12.10",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "@huggingface/transformers": "^4.3.1",
    "@mediabunny/aac-encoder": "^1.61.3",
    "@mediabunny/mp3-encoder": "^1.61.3",
    "@radix-ui/react-icons": "^1.3.2",
    "framer-motion": "^14.0.0",
    "i18next": "^26.4.2",
    "i18next-browser-languagedetector": "^8.2.1",
    "immer": "^11.1.21",
    "mediabunny": "^1.61.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.16",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@astrojs/react": "^7.0.1",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "astro": "^7.3.8",
    "oxlint": "^1.87.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  },
  "allowScripts": {
    "onnxruntime-node": false,
    "protobufjs": false
  }
}
