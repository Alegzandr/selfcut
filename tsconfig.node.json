{
  "compilerOptions": {
    "target": "ES2022",
    // DOM as well as ES2022: the e2e specs are Node code, but the bodies of
    // their `page.evaluate` callbacks are browser code that is typechecked
    // here. Without it every canvas, every bitmap and every rAF in a spec has
    // to be laundered through a `globalThis as unknown as {...}` cast, which
    // hides real mistakes among the ceremony.
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "strict": true,
    "types": ["node"]
  },
  "include": [
    "astro.config.ts",
    "vitest.config.ts",
    "playwright.config.ts",
    "playwright.prod.config.ts",
    "integrations",
    "e2e"
  ]
}
